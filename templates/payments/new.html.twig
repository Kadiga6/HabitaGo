{% extends 'base.html.twig' %}

{% block title %}Nouveau Paiement - HabitaGo{% endblock %}

{% block body %}
<style>
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .animate-fade-in {
        animation: fadeIn 0.5s ease-out forwards;
    }

    .page-header {
        margin-bottom: 2.5rem;
    }

    .page-title {
        font-weight: 800;
        font-size: 1.5rem;
        color: #1e293b;
        margin-bottom: 0.5rem;
    }

    .step-indicator {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        color: #64748b;
        margin-bottom: 1rem;
    }

    .step-item.active .step-indicator {
        background: var(--primary-gradient);
        color: white;
    }
</style>

<div class="container-fluid animate-fade-in">
    <header class="page-header d-flex align-items-center gap-3">
        <a href="{{ path('payments_index') }}" class="btn btn-light rounded-circle shadow-sm d-flex align-items-center justify-content-center p-0" style="width: 40px; height: 40px; background: white; border: none;">
            <i class="bi bi-chevron-left text-primary"></i>
        </a>
        <h1 class="page-title mb-0">Régulariser un paiement</h1>
    </header>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="glass-card p-4 p-md-5">
                <div class="text-center mb-5">
                    <h2 class="fw-extrabold text-dark mb-2">Finalisez votre règlement</h2>
                    <p class="text-muted fw-bold">Remplissez les informations ci-dessous pour confirmer votre paiement.</p>
                </div>

                {{ form_start(form) }}
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-uppercase text-muted">Période concernée</label>
                            {{ form_widget(form.periode, {'attr': {'class': 'form-control form-glass-control', 'readonly': 'readonly'}}) }}
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-uppercase text-muted">Montant à régler (€)</label>
                            {{ form_widget(form.montant, {'attr': {'class': 'form-control form-glass-control', 'readonly': 'readonly'}}) }}
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small text-uppercase text-muted">Moyen de paiement</label>
                            {{ form_widget(form.moyenPaiement, {'attr': {'class': 'form-select form-glass-control'}}) }}
                        </div>

                        <div class="col-12 mt-5">
                            <div class="p-3 rounded-4 bg-soft-primary border border-primary-subtle d-flex align-items-start gap-3 mb-4">
                                <i class="bi bi-info-circle-fill text-primary fs-4"></i>
                                <div class="small text-dark fw-bold">
                                    En cliquant sur "Confirmer le paiement", vous déclarez avoir effectué le virement ou le règlement correspondant à la période indiquée.
                                </div>
                            </div>
                            
                            <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold shadow-lg py-3">
                                <i class="bi bi-check2-circle me-2"></i> Confirmer le paiement
                            </button>
                        </div>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
