{% extends 'base.html.twig' %}

{% block title %}Paiement Sécurisé - HabitaGo{% endblock %}

{% block body %}
<style>
    .pay-container {
        max-width: 550px;
        margin: 2rem auto;
        perspective: 1000px;
    }

    .pay-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 32px;
        box-shadow: 0 40px 100px -20px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes slideUp {
        from { opacity: 0; transform: translateY(30px) rotateX(-5deg); }
        to { opacity: 1; transform: translateY(0) rotateX(0); }
    }

    .pay-header {
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
        padding: 2.5rem 2rem;
        color: white;
        text-align: center;
        position: relative;
    }

    .pay-header::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 40px;
        background: white;
        clip-path: ellipse(60% 100% at 50% 110%);
    }

    .lock-icon {
        width: 56px;
        height: 56px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(10px);
        margin-bottom: 1.25rem;
        font-size: 1.5rem;
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    .pay-body {
        padding: 2rem 2.5rem 3rem;
    }

    .billing-summary {
        background: #f8fafc;
        border-radius: 20px;
        padding: 1.5rem;
        margin-bottom: 2rem;
    }

    .summary-item {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.75rem;
    }

    .summary-label {
        color: #64748b;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .summary-value {
        color: #1e293b;
        font-weight: 700;
        font-size: 0.85rem;
    }

    .total-amount {
        border-top: 1px solid #e2e8f0;
        margin-top: 1rem;
        padding-top: 1rem;
        text-align: center;
    }

    .amount-value {
        font-size: 2.75rem;
        font-weight: 900;
        color: #1e293b;
        letter-spacing: -1px;
    }

    .method-card {
        border: 2px solid #f1f5f9;
        border-radius: 20px;
        padding: 1.25rem;
        margin-bottom: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 1.25rem;
        background: white;
    }

    .method-card.selected {
        border-color: #4f46e5;
        background: #f5f3ff;
        box-shadow: 0 10px 20px -5px rgba(79, 70, 229, 0.1);
    }

    .card-icon {
        width: 48px;
        height: 48px;
        background: #f8fafc;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        color: #4f46e5;
    }

    .btn-pay-premium {
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
        color: white;
        width: 100%;
        border: none;
        padding: 1.15rem;
        border-radius: 18px;
        font-weight: 800;
        font-size: 1.1rem;
        margin-top: 1.5rem;
        box-shadow: 0 15px 30px -5px rgba(79, 70, 229, 0.3);
        transition: all 0.3s;
    }

    .btn-pay-premium:hover {
        transform: translateY(-2px);
        box-shadow: 0 20px 40px -5px rgba(79, 70, 229, 0.4);
    }

    .secure-footer {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        color: #94a3b8;
        font-size: 0.75rem;
        font-weight: 700;
        margin-top: 2rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

</style>

<div class="container pb-5">
    <div class="pay-container">
        <div class="pay-card">
            <div class="pay-header">
                <div class="lock-icon">
                    <i class="bi bi-shield-check"></i>
                </div>
                <h2 class="fw-900 mb-1">Finaliser le paiement</h2>
                <p class="small fw-bold opacity-75">Transaction cryptée en 256 bits</p>
            </div>

            <div class="pay-body">
                <div class="billing-summary">
                    <div class="summary-item">
                        <span class="summary-label">Objet</span>
                        <span class="summary-value">Loyer de {{ paiement.periode }}</span>
                    </div>
                    <div class="summary-item">
                        <span class="summary-label">Locataire</span>
                        <span class="summary-value">{{ app.user.prenom }} {{ app.user.nom }}</span>
                    </div>
                    <div class="total-amount">
                        <span class="summary-label text-uppercase small">Montant à régler</span>
                        <div class="amount-value text-primary">{{ paiement.montant|number_format(2, ',', ' ') }} <small class="fs-4">€</small></div>
                    </div>
                </div>

                <div class="payment-methods">
                    <label class="summary-label mb-3 d-block text-uppercase">Choix du moyen de paiement</label>
                    
                    {{ form_start(form) }}
                        <div class="d-flex flex-column gap-2 mb-4">
                            {% for card in cards %}
                                <div class="method-card {% if loop.first %}selected{% endif %}" onclick="selectCard(this, '{{ card.type }} **** {{ card.dernierQuatre }}')">
                                    <div class="card-icon">
                                        <i class="bi bi-credit-card-2-back-fill"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="fw-bold text-dark small">{{ card.type }} **** {{ card.dernierQuatre }}</div>
                                        <div class="text-muted" style="font-size: 0.7rem;">Exp. {{ card.dateExpiration }}</div>
                                    </div>
                                    <div class="check-mark">
                                        {% if loop.first %}
                                            <i class="bi bi-check-circle-fill text-primary"></i>
                                        {% else %}
                                            <i class="bi bi-circle text-muted"></i>
                                        {% endif %}
                                    </div>
                                </div>
                            {% else %}
                                <div class="method-card selected">
                                    <div class="card-icon">
                                        <i class="bi bi-plus-circle-fill"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="fw-bold text-dark small">Nouvelle Carte Bancaire</div>
                                        <div class="text-muted" style="font-size: 0.7rem;">Saisie sécurisée</div>
                                    </div>
                                    <i class="bi bi-check-circle-fill text-primary"></i>
                                </div>
                            {% endfor %}
                        </div>

                        <div class="d-none">
                            {{ form_widget(form.moyenPaiement) }}
                        </div>

                        <button type="submit" class="btn btn-pay-premium">
                            Procéder au paiement
                        </button>
                    {{ form_end(form) }}
                </div>

                <div class="secure-footer">
                    <i class="bi bi-lock-fill"></i>
                    SSL Secure Transaction • PCI DSS
                </div>
            </div>
        </div>

        <div class="text-center mt-3">
            <a href="{{ path('payments_index') }}" class="btn btn-link text-muted text-decoration-none small fw-bold">
                <i class="bi bi-arrow-left me-1"></i> Annuler le paiement
            </a>
        </div>
    </div>
</div>

<script>
    function selectCard(element, value) {
        document.querySelectorAll('.method-card').forEach(c => {
            c.classList.remove('selected');
            c.querySelector('.check-mark').innerHTML = '<i class="bi bi-circle text-muted"></i>';
        });
        
        element.classList.add('selected');
        element.querySelector('.check-mark').innerHTML = '<i class="bi bi-check-circle-fill text-primary"></i>';
        
        document.querySelector('#paiement_moyenPaiement').value = value;
    }
</script>
{% endblock %}
