{% extends 'base.html.twig' %}

{% block title %}Paiements - HabitaGo{% endblock %}

{% block body %}
<style>
    @font-face {
        font-family: 'Outfit';
        src: url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap');
    }

    body {
        font-family: 'Outfit', sans-serif;
        background-color: #f8fafc;
    }

    .animate-in {
        animation: fadeIn 0.8s ease-out;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(5px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .page-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 4rem 1.5rem;
    }

    .header-minimal {
        margin-bottom: 3.5rem;
        border-left: 4px solid #6366f1;
        padding-left: 1.5rem;
    }

    .header-minimal h1 {
        font-weight: 800;
        font-size: 2rem;
        color: #0f172a;
        letter-spacing: -0.02em;
        margin-bottom: 0.25rem;
    }

    .header-minimal p {
        color: #64748b;
        font-weight: 500;
    }

    .year-section {
        margin-bottom: 3rem;
    }

    .year-header {
        font-size: 0.85rem;
        font-weight: 800;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 1rem;
        padding-left: 0.5rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .year-header::after {
        content: '';
        flex-grow: 1;
        height: 1px;
        background: #e2e8f0;
    }

    .payment-list {
        background: white;
        border-radius: 18px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        overflow: hidden;
        border: 1px solid #e2e8f0;
    }

    .payment-row {
        display: grid;
        grid-template-columns: 1fr 120px 140px 100px;
        align-items: center;
        padding: 1rem 1.75rem;
        border-bottom: 1px solid #f1f5f9;
        transition: all 0.2s ease;
    }

    .payment-row:last-child {
        border-bottom: none;
    }

    .payment-row:hover {
        background-color: #fcfdfe;
    }

    .period-name {
        font-weight: 700;
        color: #1e293b;
        font-size: 1rem;
        text-transform: capitalize;
    }

    .amount {
        font-weight: 700;
        color: #0f172a;
        font-size: 1rem;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.65rem;
        font-weight: 800;
        text-transform: uppercase;
        padding: 6px 14px;
        border-radius: 100px;
        letter-spacing: 0.03em;
    }

    .bg-soft-payé { background: #dcfce7; color: #15803d; }
    .bg-soft-attente { background: #f0f9ff; color: #0369a1; }
    .bg-soft-retard { background: #fee2e2; color: #dc2626; }

    .btn-pay {
        background: #0f172a;
        color: white;
        border: none;
        padding: 6px 14px;
        border-radius: 8px;
        font-weight: 750;
        font-size: 0.7rem;
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-block;
    }

    .btn-pay:hover {
        background: #334155;
        transform: translateY(-1px);
        color: white;
    }

    .icon-symbol {
        font-size: 1.25rem;
        text-align: center;
    }

    .text-muted-compact { color: #94a3b8; font-size: 0.8rem; font-weight: 500; }
</style>

<div class="page-container animate-in">
    <header class="header-minimal">
        <h1>Mes Paiements</h1>
        <p>Historique et gestion des loyers.</p>
    </header>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success border-0 rounded-4 shadow-sm mb-4 fw-bold p-3" style="background: #ecfdf5; color: #065f46;">
            <i class="bi bi-check-circle-fill me-2"></i> {{ message }}
        </div>
    {% endfor %}

    {% set currentYear = "" %}
    
    {% for p in paiements %}
        {% set pYear = p.periode|split(' ')|last %}
        
        {% if pYear != currentYear %}
            {% if currentYear != "" %}</div></div>{% endif %}
            <div class="year-section">
                <div class="year-header">Année {{ pYear }}</div>
                <div class="payment-list shadow-sm">
            {% set currentYear = pYear %}
        {% endif %}

        <div class="payment-row">
            <div class="period-name">{{ p.periode|split(' ')|first }}</div>
            
            <div class="amount">
                {{ p.montant|number_format(2, ',', ' ') }} €
            </div>

            <div>
                {% if p.statut == 'paye' %}
                    <span class="status-badge bg-soft-payé">
                        <i class="bi bi-shield-check"></i> RÉGLÉ
                    </span>
                {% elseif p.statut == 'en_attente' %}
                    <span class="status-badge bg-soft-attente">
                        <i class="bi bi-arrow-repeat spin-slow"></i> ATTENTE
                    </span>
                {% else %}
                    <span class="status-badge bg-soft-retard">
                        <i class="bi bi-exclamation-triangle"></i> RETARD
                    </span>
                {% endif %}
            </div>

            <div class="text-end">
                {% if p.statut == 'en_retard' %}
                    <a href="{{ path('payments_pay', {id: p.id}) }}" class="btn-pay">
                        Payer
                    </a>
                {% elseif p.statut == 'en_attente' %}
                    <div class="icon-symbol text-info" title="Paiement en attente">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                {% else %}
                    <div class="icon-symbol text-success">
                        <i class="bi bi-patch-check-fill"></i>
                    </div>
                {% endif %}
            </div>
        </div>
        
        {% if loop.last %}</div></div>{% endif %}
    {% else %}
        <div class="glass-card p-5 text-center">
            <i class="bi bi-inbox text-muted opacity-25 d-block mb-3" style="font-size: 3rem;"></i>
            <p class="text-muted fw-bold">Aucune donnée de paiement disponible.</p>
        </div>
    {% endfor %}

    <footer class="mt-5 text-center">
        <p class="text-muted-compact">
            <i class="bi bi-lock-fill me-1"></i> Transactions sécurisées par HabitaGo Secure
        </p>
    </footer>
</div>

<style>
    @keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
    .spin-slow { animation: spin 3s linear infinite; display: inline-block; }
</style>
{% endblock %}
