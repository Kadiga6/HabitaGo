{% extends 'base.html.twig' %}

{% block title %}Paiement Réussi - HabitaGo{% endblock %}

{% block body %}
<style>
    .success-card {
        max-width: 600px;
        margin: 4rem auto;
        padding: 4rem;
        text-align: center;
        background: white;
        border-radius: 32px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.05);
    }

    .success-icon {
        width: 100px;
        height: 100px;
        background: #10b981;
        color: white;
        font-size: 3rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 2.5rem;
        box-shadow: 0 10px 25px rgba(16, 185, 129, 0.3);
        position: relative;
    }

    .success-icon::after {
        content: '';
        position: absolute;
        width: 120%;
        height: 120%;
        border: 2px solid #10b981;
        border-radius: 50%;
        opacity: 0.2;
        animation: pulse 2s infinite;
    }

    @keyframes pulse {
        0% { transform: scale(1); opacity: 0.2; }
        100% { transform: scale(1.4); opacity: 0; }
    }

    .transaction-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1.25rem;
        background: #f8fafc;
        border-radius: 100px;
        font-weight: 700;
        color: #64748b;
        font-size: 0.85rem;
        margin-bottom: 2rem;
    }
</style>

<div class="container animate-fade-in">
    <div class="success-card">
        <div class="success-icon">
            <i class="bi bi-check-lg"></i>
        </div>
        
        <h1 class="fw-extrabold text-dark mb-3" style="font-size: 2.5rem;">Paiement Confirmé !</h1>
        <p class="text-muted fw-bold mb-4">
            Merci ! Votre paiement pour le mois de <span class="text-primary">{{ paiement.periode }}</span> a été traité avec succès.
        </p>

        <div class="transaction-pill">
            <i class="bi bi-shield-check text-success"></i>
            Transaction #HG-{{ "now"|date("Ymd") }}-{{ paiement.id }}
        </div>

        <div class="bg-light p-4 rounded-4 mb-5 border-0 text-start">
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted small fw-bold">Montant réglé</span>
                <span class="text-dark fw-extrabold">{{ paiement.montant|number_format(2, ',', ' ') }} €</span>
            </div>
            <div class="d-flex justify-content-between">
                <span class="text-muted small fw-bold">Mode de paiement</span>
                <span class="text-dark fw-extrabold">{{ paiement.moyenPaiement|default('Carte Bancaire')|capitalize }}</span>
            </div>
        </div>

        <div class="d-flex flex-column gap-3">
            <a href="{{ path('payments_index') }}" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-lg py-3">
                Consulter mes reçus
            </a>
            <a href="{{ path('app_dashboard') }}" class="btn btn-link link-secondary fw-bold text-decoration-none">
                Retour au tableau de bord
            </a>
        </div>
    </div>
</div>
{% endblock %}
