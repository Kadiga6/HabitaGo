<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}HabitaGo{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>"> 
    
    {# Google Fonts - Plus Jakarta Sans for Premium SaaS Look #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    {# Bootstrap 5 CSS #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --primary-color: #667eea;
            --secondary-color: #764ba2;
            --bg-color: #eff2f6;
            --glass-bg: rgba(255, 255, 255, 0.7);
            --glass-border: rgba(255, 255, 255, 0.25);
            --sidebar-width: 240px;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
            background-color: var(--bg-color);
            color: #2c3e50;
            margin: 0;
            overflow-x: hidden;
        }

        /* Layout Architecture */
        .app-wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* Global Alert & Badges */
        .alert-modern {
            background: var(--glass-bg);
            backdrop-filter: blur(10px);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
            font-weight: 500;
        }

        .alert-success { border-left: 4px solid #10b981; }
        .alert-danger { border-left: 4px solid #ef4444; }
        .alert-warning { border-left: 4px solid #f59e0b; }

        /* Main Content wrapper */
        .content-wrapper {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            width: 100%;
            min-height: 100vh;
            transition: all 0.3s ease;
        }
        
        .main-content {
            padding: 1.5rem;
            flex-grow: 1;
        }

        @media (max-width: 991.98px) {
            .main-content {
                padding: 1rem;
            }
        }

        /* Glassmorphism utility */
        .glass-card {
            background: var(--glass-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
        }
        
        .glass-header {
            background: var(--glass-bg);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--glass-border);
            position: sticky;
            top: 0;
            z-index: 10;
        }
    </style>
</head>

<body>
    {% set is_auth = app.request.attributes.get('_route') in ['app_login', 'app_register'] %}

    {% if not is_auth %}
        <div class="app-wrapper">
            {# Sidebar Included #}
            {% include 'partials/navbar.html.twig' %}
            
            <div class="content-wrapper">
                {# Mobile Topbar Overlay (Visible only on mobile) #}
                <div class="d-lg-none glass-header p-3 d-flex justify-content-between align-items-center">
                    <span class="fs-4 fw-bold" style="background: var(--primary-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">HabitaGo</span>
                    <button class="btn border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#sidebarCollapse" aria-expanded="false" aria-controls="sidebarCollapse">
                        <i class="bi bi-list fs-2 text-dark"></i>
                    </button>
                </div>
                
                <main class="main-content">
                    {# Messages flash #}
                    <div class="container-fluid p-0 mb-3">
                        {% for type, messages in app.flashes %}
                            {% for message in messages %}
                                <div class="alert alert-modern alert-{{ type }} alert-dismissible fade show d-flex align-items-center" role="alert">
                                    {% if type == 'success' %}<i class="bi bi-check-circle-fill fs-4 text-success me-3"></i>{% endif %}
                                    {% if type == 'error' or type == 'danger' %}<i class="bi bi-x-circle-fill fs-4 text-danger me-3"></i>{% endif %}
                                    {% if type == 'warning' %}<i class="bi bi-exclamation-triangle-fill fs-4 text-warning me-3"></i>{% endif %}
                                    <div>
                                        <strong>{{ message }}</strong>
                                    </div>
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            {% endfor %}
                        {% endfor %}
                    </div>
    {% endif %}

    {% block body %}{% endblock %}

    {% if not is_auth %}
                </main>
            </div>
        </div>
    {% endif %}

    {# Bootstrap 5 JS Bundle #}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>