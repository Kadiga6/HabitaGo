<style>
/* Sidebar Setup */
.sidebar {
    width: var(--sidebar-width);
    min-width: var(--sidebar-width);
    height: 100vh;
    position: sticky;
    top: 0;
    left: 0;
    background: rgba(255, 255, 255, 0.85); /* Plus opaque pour plus de consistance */
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-right: 1px solid rgba(0, 0, 0, 0.05);
    box-shadow: 4px 0 24px rgba(0, 0, 0, 0.02);
    display: flex;
    flex-direction: column;
    z-index: 1040;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.sidebar-header {
    padding: 1.5rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 10px;
}

.brand-text {
    font-size: 1.25rem;
    font-weight: 800;
    background: var(--primary-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: -0.5px;
    margin: 0;
}

/* Nav Links */
.sidebar-nav {
    flex-grow: 1;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    overflow-y: auto;
}

.sidebar-nav::-webkit-scrollbar {
    width: 6px;
}
.sidebar-nav::-webkit-scrollbar-track {
    background: transparent;
}
.sidebar-nav::-webkit-scrollbar-thumb {
    background-color: rgba(0,0,0,0.1);
    border-radius: 10px;
}

.nav-item-glass {
    padding: 0.65rem 1rem;
    border-radius: 12px;
    color: #64748b;
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 14px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.nav-item-glass i {
    font-size: 1.1rem;
    opacity: 0.8;
}

.nav-item-glass:hover {
    color: var(--primary-color);
    background: rgba(102, 126, 234, 0.08);
    transform: translateX(4px);
}

.nav-item-glass.active {
    background: var(--primary-gradient);
    color: white;
    box-shadow: 0 4px 15px rgba(102, 126, 234, 0.35);
}

.nav-item-glass.active i {
    opacity: 1;
}

/* User Card Bottom */
.sidebar-footer {
    padding: 1.5rem;
    border-top: 1px solid rgba(0, 0, 0, 0.05);
}

.user-glass-card {
    background: white;
    border: 1px solid rgba(0, 0, 0, 0.05);
    border-radius: 14px;
    padding: 1rem;
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: #1e293b;
    transition: all 0.3s ease;
    cursor: pointer;
    position: relative;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
}

.user-glass-card:hover, .user-glass-card[aria-expanded="true"] {
    box-shadow: 0 8px 24px rgba(102, 126, 234, 0.15);
    border-color: rgba(102, 126, 234, 0.3);
}

.avatar-circle {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--primary-gradient);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1rem;
    box-shadow: 0 4px 10px rgba(102, 126, 234, 0.3);
    flex-shrink: 0;
}

.user-info {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    flex-grow: 1;
}

.user-name {
    font-weight: 700;
    font-size: 0.95rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: #0f172a;
}

.user-role {
    font-size: 0.75rem;
    color: #64748b;
    font-weight: 500;
}

.user-dropdown-menu {
    border: none;
    border-radius: 16px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    padding: 0.5rem;
    min-width: 240px;
    margin-bottom: 0.5rem !important;
}

.user-dropdown-item {
    border-radius: 10px;
    padding: 0.75rem 1rem;
    font-weight: 600;
    color: #475569;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 10px;
}

.user-dropdown-item:hover {
    background: rgba(102, 126, 234, 0.08);
    color: var(--primary-color);
}

.user-dropdown-item.text-danger:hover {
    background: rgba(239, 68, 68, 0.08);
    color: #ef4444;
}

/* Mobile offcanvas */
@media (max-width: 991.98px) {
    .sidebar {
        position: fixed;
        transform: translateX(-100%);
    }
    
    .sidebar.collapse.show {
        transform: translateX(0);
    }

    /* Mobile Backdrop */
    .sidebar-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(4px);
        z-index: 1030;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
    }

    .sidebar-backdrop.show {
        opacity: 1;
        visibility: visible;
    }
}
</style>

{# Mobile backdrop #}
<div class="sidebar-backdrop d-lg-none" data-bs-toggle="collapse" data-bs-target="#sidebarCollapse"></div>

<aside class="sidebar collapse d-lg-flex" id="sidebarCollapse">
    <div class="sidebar-header">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <linearGradient id="brandGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" style="stop-color:#667eea;stop-opacity:1" />
                    <stop offset="100%" style="stop-color:#764ba2;stop-opacity:1" />
                </linearGradient>
            </defs>
            <path d="M12 3L3 9V21H21V9L12 3Z" stroke="url(#brandGrad)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            <path d="M9 21V12H15V21" stroke="url(#brandGrad)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="brand-text">HabitaGo</span>
    </div>

    <nav class="sidebar-nav">
        <a class="nav-item-glass {{ app.request.attributes.get('_route') starts with 'app_dashboard' ? 'active' : '' }}" href="{{ path('app_dashboard') }}">
            <i class="bi bi-grid-1x2-fill"></i>
            Tableau de Bord
        </a>
        
        <a class="nav-item-glass {{ app.request.attributes.get('_route') starts with 'app_logement' ? 'active' : '' }}" href="{{ path('app_logement') }}">
            <i class="bi bi-house-door-fill"></i>
            Mon Logement
        </a>
        
        <a class="nav-item-glass {{ app.request.attributes.get('_route') starts with 'payments' ? 'active' : '' }}" href="{{ path('payments_index') }}">
            <i class="bi bi-credit-card-fill"></i>
            Paiements
        </a>
        
        <a class="nav-item-glass {{ app.request.attributes.get('_route') starts with 'consumption' ? 'active' : '' }}" href="{{ path('consumption') }}">
            <i class="bi bi-lightning-charge-fill"></i>
            Consommations
        </a>
        
        <a class="nav-item-glass {{ app.request.attributes.get('_route') starts with 'issues' ? 'active' : '' }}" href="{{ path('issues') }}">
            <i class="bi bi-exclamation-triangle-fill"></i>
            Incidents
        </a>
    </nav>

    <div class="sidebar-footer">
        {% if app.user %}
            <div class="dropdown dropup">
                <div class="user-glass-card" data-bs-toggle="dropdown" aria-expanded="false" role="button">
                    <div class="avatar-circle">
                        {{ app.user.initials }}
                    </div>
                    <div class="user-info">
                        <span class="user-name">{{ app.user.prenom }} {{ app.user.nom }}</span>
                        <span class="user-role">Locataire Pro</span>
                    </div>
                    <i class="bi bi-chevron-up text-muted ms-auto" style="font-size: 0.8rem;"></i>
                </div>
                
                <ul class="dropdown-menu user-dropdown-menu">
                    <li><h6 class="dropdown-header">Mon Compte</h6></li>
                    <li>
                        <a class="dropdown-item user-dropdown-item" href="{{ path('profile') }}">
                            <i class="bi bi-person-circle"></i> Profil locataire
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item user-dropdown-item" href="{{ path('settings') }}">
                            <i class="bi bi-gear-fill"></i> Paramètres
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item user-dropdown-item text-danger" href="{{ path('app_logout') }}">
                            <i class="bi bi-box-arrow-right"></i> Déconnexion
                        </a>
                    </li>
                </ul>
            </div>
        {% else %}
            <div class="d-flex flex-column gap-2">
                <a href="{{ path('app_login') }}" class="btn btn-outline-primary" style="border-radius: 12px; font-weight: 600;">Connexion</a>
                <a href="{{ path('app_register') }}" class="btn btn-primary" style="border-radius: 12px; font-weight: 600; background: var(--primary-gradient); border: none;">Inscription</a>
            </div>
        {% endif %}
    </div>
</aside>

<script>
    // Script pour gérer l'affichage du fond noir semi-transparent sur mobile
    document.addEventListener('DOMContentLoaded', () => {
        const sidebar = document.getElementById('sidebarCollapse');
        const backdrop = document.querySelector('.sidebar-backdrop');
        
        if(sidebar && backdrop) {
            sidebar.addEventListener('show.bs.collapse', () => {
                backdrop.classList.add('show');
            });
            
            sidebar.addEventListener('hide.bs.collapse', () => {
                backdrop.classList.remove('show');
            });
        }
    });
</script>