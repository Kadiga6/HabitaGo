{% extends 'base.html.twig' %}

{% block title %}Tableau de bord - HabitaGo{% endblock %}

{% block body %}
<style>
    /* Dashboard specific animations */
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .animate-fade-in {
        animation: fadeIn 0.5s ease-out forwards;
    }

    /* Page Header */
    .page-header {
        margin-bottom: 2.5rem;
    }

    .welcome-text {
        font-weight: 800;
        font-size: 1.5rem;
        color: #1e293b;
        margin-bottom: 0.5rem;
    }

    .sub-text {
        color: #64748b;
        font-weight: 500;
    }

    /* Stats Cards */
    .stat-card {
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        height: 100%;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: white;
        margin-bottom: 0.5rem;
    }

    .stat-label {
        font-weight: 700;
        color: #64748b;
        font-size: 0.875rem;
        text-transform: uppercase;
        letter-spacing: 0.025em;
    }

    .stat-value {
        font-size: 1.5rem;
        font-weight: 800;
        color: #0f172a;
    }

    /* Quick Action Card */
    .action-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 1rem;
    }

    .action-item {
        padding: 1.25rem;
        text-align: center;
        border-radius: 16px;
        text-decoration: none;
        transition: all 0.2s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
        background: white;
        border: 1px solid rgba(0,0,0,0.05);
    }

    .action-item i {
        font-size: 1.75rem;
    }

    .action-item span {
        font-weight: 600;
        font-size: 0.9rem;
        color: #1e293b;
    }

    .action-item:hover {
        background: var(--primary-gradient);
        border-color: transparent;
        transform: translateY(-3px);
    }

    .action-item:hover span, .action-item:hover i {
        color: white !important;
    }

    /* Tables & Lists in Cards */
    .section-title {
        font-weight: 700;
        font-size: 1.1rem;
        color: #1e293b;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .data-row {
        padding: 1rem;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        transition: background 0.2s ease;
    }

    .data-row:hover {
        background: rgba(0,0,0,0.02);
    }

    .badge-modern {
        padding: 0.5rem 1rem;
        border-radius: 30px;
        font-weight: 700;
        font-size: 0.75rem;
    }

    .bg-soft-success { background: #dcfce7; color: #166534; }
    .bg-soft-warning { background: #fef9c3; color: #854d0e; }
    .bg-soft-danger { background: #fee2e2; color: #991b1b; }
    .bg-soft-info { background: #e0f2fe; color: #075985; }

</style>

<div class="container-fluid animate-fade-in">
    {# Page Header #}
    <header class="page-header">
        <h1 class="welcome-text">Bonjour, {{ app.user.prenom }} ! <span class="wave">👋</span></h1>
        <p class="sub-text">Voici un aperçu de votre logement chez <strong>HabitaGo</strong>.</p>
    </header>

    {# Top Alerts #}
    {% if contrat and contrat.montantLoyer > 0 %}
    <div class="alert alert-modern alert-warning border-0 p-4 mb-5 d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center">
            <div class="stat-icon bg-warning text-dark me-3 shadow-sm">
                <i class="bi bi-wallet2"></i>
            </div>
            <div>
                <h6 class="mb-1 fw-bold">Paiement du loyer en attente</h6>
                <p class="mb-0 text-muted small">N'oubliez pas de régler votre loyer avant le 5 du mois.</p>
            </div>
        </div>
        <a href="{{ path('payments_index') }}" class="btn btn-dark btn-sm rounded-pill px-4 fw-bold shadow-sm">Payer maintenant</a>
    </div>
    {% endif %}

    {# Stats Grid #}
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="glass-card stat-card">
                <div class="stat-icon" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%)">
                    <i class="bi bi-cash-stack"></i>
                </div>
                <div class="stat-info">
                    <span class="stat-label">Loyer mensuel</span>
                    <div class="stat-value">{% if contrat %}{{ contrat.montantLoyer|number_format(2, ',', ' ') }} €{% else %}—{% endif %}</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="glass-card stat-card">
                <div class="stat-icon" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%)">
                    <i class="bi bi-lightning-charge"></i>
                </div>
                <div class="stat-info">
                    <span class="stat-label">Élec (kWh)</span>
                    <div class="stat-value">{{ totauxConsommation.electricite|default(0)|number_format(1, ',', ' ') }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="glass-card stat-card">
                <div class="stat-icon" style="background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%)">
                    <i class="bi bi-droplet"></i>
                </div>
                <div class="stat-info">
                    <span class="stat-label">Eau (m³)</span>
                    <div class="stat-value">{{ totauxConsommation.eau|default(0)|number_format(1, ',', ' ') }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="glass-card stat-card">
                <div class="stat-icon" style="background: linear-gradient(135deg, #f97316 0%, #ea580c 100%)">
                    <i class="bi bi-fire"></i>
                </div>
                <div class="stat-info">
                    <span class="stat-label">Gaz (kWh)</span>
                    <div class="stat-value">{{ totauxConsommation.gaz|default(0)|number_format(1, ',', ' ') }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <a href="{{ path('payments_index') }}" class="text-decoration-none h-100">
                <div class="glass-card stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%)">
                        <i class="bi bi-exclamation-octagon"></i>
                    </div>
                    <div class="stat-info">
                        <span class="stat-label">Loyers en retard</span>
                        <div class="stat-value">{{ paymentStats.en_retard }}</div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <div class="row g-4 mb-5">
        {# Left Column: Quick Actions & Incidents #}
        <div class="col-lg-8">
            <div class="glass-card p-4 mb-4">
                <h3 class="section-title"><i class="bi bi-lightning-fill text-warning"></i> Actions rapides</h3>
                <div class="action-grid">
                    <a href="{{ path('payments_index') }}" class="action-item">
                        <i class="bi bi-credit-card text-success"></i>
                        <span>Payer loyer</span>
                    </a>
                    <a href="{{ path('issues_new') }}" class="action-item">
                        <i class="bi bi-plus-circle text-danger"></i>
                        <span>Signaler bug</span>
                    </a>
                    <a href="{{ path('consumption') }}" class="action-item">
                        <i class="bi bi-bar-chart-line text-info"></i>
                        <span>Consommation</span>
                    </a>
                    <a href="{{ path('profile') }}" class="action-item">
                        <i class="bi bi-person-badge text-primary"></i>
                        <span>Mon Profil</span>
                    </a>
                </div>
            </div>

            <div class="glass-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="section-title mb-0"><i class="bi bi-tools text-secondary"></i> Incidents en cours</h3>
                    <a href="{{ path('issues') }}" class="btn btn-link link-primary p-0 fw-bold">Tout voir</a>
                </div>
                
                <div class="incident-list">
                    {% if incidents is defined and incidents|length > 0 %}
                        {% for incident in incidents|filter(i => i.dateResolution is null)|slice(0, 3) %}
                            <div class="data-row mb-2">
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle bg-soft-{{ incident.priorite == 'urgente' ? 'danger' : 'warning' }} p-2 me-3">
                                        <i class="bi bi-{{ incident.priorite == 'urgente' ? 'fire' : 'wrench' }}"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">{{ incident.titre }}</div>
                                        <div class="text-muted small">Ouvert le {{ incident.dateCreation|date('d/m/Y') }}</div>
                                    </div>
                                </div>
                                <span class="badge-modern bg-soft-{{ incident.priorite == 'urgente' ? 'danger' : 'warning' }}">
                                    {{ incident.priorite|upper }}
                                </span>
                            </div>
                        {% endfor %}
                    {% else %}
                        <div class="text-center py-5">
                            <i class="bi bi-check2-circle text-success" style="font-size: 3rem;"></i>
                            <p class="mt-3 text-muted fw-bold">Parfait ! Aucun incident signalé.</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {# Right Column: Housing Info & Stats #}
        <div class="col-lg-4">
            <div class="glass-card p-4 mb-4">
                <h3 class="section-title"><i class="bi bi-house-heart-fill text-danger"></i> Votre Logement</h3>
                <div class="p-3 rounded-4 bg-white border border-light mb-3">
                    <div class="text-muted small fw-bold mb-1">ADRESSE</div>
                    <div class="fw-bold text-dark mb-3">
                        {% if logement %}
                            {{ logement.adresse }}<br>
                            {{ logement.codePostal }} {{ logement.ville }}
                        {% else %}
                            <span class="text-muted">Non renseigné</span>
                        {% endif %}
                    </div>
                    
                    <div class="row g-2">
                        <div class="col-6">
                            <div class="text-muted small fw-bold mb-1">TYPE</div>
                            <div class="fw-bold text-dark">{{ logement.typeLogement|default('—') }}</div>
                        </div>
                        <div class="col-6">
                            <div class="text-muted small fw-bold mb-1">STATUT BAIL</div>
                            <span class="badge bg-success rounded-pill px-3">Actif</span>
                        </div>
                    </div>
                </div>
                <div class="text-center">
                    <a href="{{ path('app_logement') }}" class="btn btn-light rounded-pill w-100 fw-bold border-0" style="background: rgba(0,0,0,0.05);">Détails du logement</a>
                </div>
            </div>

            <div class="glass-card p-4">
                <h3 class="section-title"><i class="bi bi-graph-up-arrow text-primary"></i> Performance</h3>
                <div class="mb-4">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="small fw-bold text-muted">Électricité</span>
                        <span class="small fw-bold text-success">-12% vs mois dernier</span>
                    </div>
                    <div class="progress" style="height: 8px; border-radius: 4px;">
                        <div class="progress-bar bg-success" style="width: 65%;"></div>
                    </div>
                </div>
                <div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="small fw-bold text-muted">Historique Paiements</span>
                        {% set ratio = paymentStats.total_attendu > 0 ? (paymentStats.payes / (paymentStats.payes + paymentStats.en_retard) * 100)|round : 100 %}
                        <span class="small fw-bold text-primary">{{ ratio }}% à temps</span>
                    </div>
                    <div class="progress" style="height: 8px; border-radius: 4px;">
                        <div class="progress-bar bg-primary" style="width: {{ ratio }}%;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
