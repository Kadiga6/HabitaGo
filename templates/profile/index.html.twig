{% extends 'base.html.twig' %}

{% block title %}Mon Profil - HabitaGo{% endblock %}

{% block body %}
<style>
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .animate-fade-in {
        animation: fadeIn 0.5s ease-out forwards;
    }

    .profile-header-premium {
        background: var(--primary-gradient);
        border-radius: 24px;
        padding: 3rem;
        color: white;
        position: relative;
        overflow: hidden;
        margin-bottom: 2rem;
        box-shadow: 0 20px 40px rgba(102, 126, 234, 0.15);
    }

    .profile-header-premium::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -10%;
        width: 400px;
        height: 400px;
        background: rgba(255,255,255,0.1);
        border-radius: 50%;
        filter: blur(80px);
    }

    .avatar-wrapper {
        position: relative;
        width: 120px;
        height: 120px;
    }

    .avatar-large {
        width: 120px;
        height: 120px;
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(10px);
        border: 4px solid rgba(255, 255, 255, 0.3);
        border-radius: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        font-weight: 800;
        color: white;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    }

    .status-indicator {
        position: absolute;
        bottom: 5px;
        right: 5px;
        width: 24px;
        height: 24px;
        background: #10b981;
        border: 4px solid #764ba2;
        border-radius: 50%;
    }

    .info-label {
        font-weight: 700;
        color: #64748b;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.25rem;
    }

    .info-value {
        font-weight: 800;
        color: #1e293b;
        font-size: 1.1rem;
    }

    .activity-item {
        padding: 1rem;
        border-radius: 12px;
        background: rgba(0,0,0,0.02);
        border-left: 4px solid var(--primary-color);
        margin-bottom: 1rem;
    }

</style>

<div class="container-fluid animate-fade-in">
    {# Main Profile Header #}
    <div class="profile-header-premium">
        <div class="row align-items-center">
            <div class="col-auto">
                <div class="avatar-wrapper">
                    <div class="avatar-large">
                        {{ app.user.initials }}
                    </div>
                    <div class="status-indicator"></div>
                </div>
            </div>
            <div class="col ms-md-4 mt-4 mt-md-0">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <h1 class="display-6 fw-extrabold mb-0">{{ app.user.prenom }} {{ app.user.nom }}</h1>
                    <span class="badge bg-white text-primary rounded-pill px-3 fw-bold">Locataire</span>
                </div>
                <p class="text-white opacity-75 fw-bold mb-4">
                    <i class="bi bi-calendar3 me-2"></i>Membre depuis le {{ housing and housing.dateCreation ? housing.dateCreation|date('M Y') : 'Mars 2024' }}
                </p>
                <div class="d-flex gap-2">
                    <a href="{{ path('settings') }}" class="btn btn-white btn-sm rounded-pill px-4 fw-bold">
                        <i class="bi bi-pencil-square me-2"></i>Éditer le profil
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        {# General Info #}
        <div class="col-lg-8">
            <div class="glass-card h-100 p-4">
                <h3 class="section-title mb-4"><i class="bi bi-person-lines-fill text-primary"></i> Coordonnées & Sécurité</h3>
                
                <div class="row g-4 mb-5">
                    <div class="col-md-6">
                        <div class="p-3 rounded-4 bg-light border-0">
                            <div class="info-label">Nom Complet</div>
                            <div class="info-value">{{ app.user.prenom }} {{ app.user.nom }}</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded-4 bg-light border-0">
                            <div class="info-label">Adresse E-mail</div>
                            <div class="info-value">{{ app.user.email }}</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded-4 bg-light border-0">
                            <div class="info-label">Identifiant Unique</div>
                            <div class="info-value text-muted">ID: #{{ app.user.id|default('---') }}</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded-4 bg-light border-0">
                            <div class="info-label">Statut du compte</div>
                            <div class="info-value text-success"><i class="bi bi-shield-check me-2"></i>Vérifié</div>
                        </div>
                    </div>
                </div>

                <h3 class="section-title mb-4 mt-5"><i class="bi bi-house-heart text-primary"></i> Résidence actuelle</h3>
                {% if housing %}
                    <div class="p-4 rounded-4 bg-soft-primary border-0">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <div class="bg-white p-3 rounded-4 shadow-sm text-primary fs-3">
                                    <i class="bi bi-geo-alt-fill"></i>
                                </div>
                            </div>
                            <div class="col">
                                <div class="fw-extrabold text-dark fs-5 mb-1">{{ housing.adresse }}</div>
                                <div class="text-muted fw-bold">{{ housing.codePostal }} {{ housing.ville }}</div>
                                <div class="mt-2">
                                    <span class="badge bg-primary rounded-pill px-3">{{ housing.typeLogement }}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="alert alert-warning border-0 rounded-4 fw-bold">
                        <i class="bi bi-exclamation-octagon me-2"></i> Aucun logement associé à votre compte.
                    </div>
                {% endif %}
            </div>
        </div>

        {# Sidebar Info #}
        <div class="col-lg-4">
            <div class="glass-card p-4 mb-4">
                <h3 class="section-title fs-6 mb-4"><i class="bi bi-activity text-primary"></i> Activité récente</h3>
                <div class="activity-item">
                    <div class="fw-bold text-dark small">Dernière connexion</div>
                    <div class="text-muted small">Aujourd'hui, à l'instant</div>
                </div>
                <div class="activity-item" style="border-left-color: #10b981;">
                    <div class="fw-bold text-dark small">Paiement validé</div>
                    <div class="text-muted small">Il y a 2 jours</div>
                </div>
            </div>

            <div class="glass-card p-4 bg-primary text-white border-0 position-relative overflow-hidden shadow-lg">
                <div style="position: absolute; top: -10px; right: -10px; font-size: 5rem; opacity: 0.1;">
                    <i class="bi bi-lightning-charge-fill"></i>
                </div>
                <h4 class="fw-extrabold mb-3">Besoin d'aide ?</h4>
                <p class="small opacity-75 fw-bold mb-4">Notre support est disponible 24/7 pour vous accompagner dans vos démarches.</p>
                <a href="{{ path('issues_new') }}" class="btn btn-white btn-sm rounded-pill px-4 fw-bold w-100 shadow-sm">
                    Ouvrir un ticket
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}