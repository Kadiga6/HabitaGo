{% extends "base.html.twig" %}

{% block title %}Mon Logement - HabitaGo{% endblock %}

{% block body %}
<style>
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .animate-fade-in {
        animation: fadeIn 0.5s ease-out forwards;
    }

    .page-header {
        margin-bottom: 2.5rem;
    }

    .page-title {
        font-weight: 800;
        font-size: 1.5rem;
        color: #1e293b;
        margin-bottom: 0.5rem;
    }

    .section-title {
        font-weight: 700;
        font-size: 1.1rem;
        color: #1e293b;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .detail-card {
        padding: 1.5rem;
        height: 100%;
    }

    .detail-item {
        margin-bottom: 1.5rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid rgba(0,0,0,0.05);
    }

    .detail-item:last-child {
        margin-bottom: 0;
        padding-bottom: 0;
        border-bottom: none;
    }

    .detail-label {
        font-weight: 700;
        color: #64748b;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.5rem;
        display: block;
    }

    .detail-value {
        font-weight: 600;
        color: #1e293b;
        font-size: 1.1rem;
    }

    .price-tag {
        font-size: 1.5rem;
        font-weight: 800;
        background: var(--primary-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    /* Consumption Mini Cards */
    .conso-mini-card {
        background: white;
        border: 1px solid rgba(0,0,0,0.05);
        border-radius: 16px;
        padding: 1.25rem;
        transition: all 0.2s ease;
    }

    .conso-mini-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.05);
    }

</style>

<div class="container-fluid animate-fade-in">
    <header class="page-header">
        <h1 class="page-title">Mon Logement</h1>
        <p class="text-muted fw-bold">Détails de votre résidence et de votre bail.</p>
    </header>

    <div class="row g-4 mb-5">
        {# Physical Property Details #}
        <div class="col-lg-6">
            <div class="glass-card detail-card">
                <h3 class="section-title"><i class="bi bi-house-door-fill text-primary"></i> Le Logement</h3>
                
                {% if logement %}
                    <div class="detail-item">
                        <span class="detail-label">Adresse complète</span>
                        <div class="detail-value">
                            <i class="bi bi-geo-alt-fill text-muted me-2"></i>
                            {{ logement.adresse }}, {{ logement.codePostal }} {{ logement.ville }}
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="detail-item">
                                <span class="detail-label">Type</span>
                                <div class="detail-value text-capitalize">{{ logement.typeLogement }}</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="detail-item">
                                <span class="detail-label">Date d'enregistrement</span>
                                <div class="detail-value">{{ logement.dateCreation ? logement.dateCreation|date('d/m/Y') : '—' }}</div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="text-center py-5">
                        <i class="bi bi-house-slash text-muted" style="font-size: 3rem; opacity: 0.3;"></i>
                        <p class="mt-3 text-muted fw-bold">Aucun logement associé à votre compte.</p>
                    </div>
                {% endif %}
            </div>
        </div>

        {# Lease / Contract Details #}
        <div class="col-lg-6">
            <div class="glass-card detail-card">
                <h3 class="section-title"><i class="bi bi-file-earmark-text-fill text-success"></i> Votre Contrat de Bail</h3>
                
                {% if contrat %}
                    <div class="detail-item">
                        <div class="row align-items-center">
                            <div class="col-6">
                                <span class="detail-label">Loyer mensuel</span>
                                <div class="price-tag">{{ contrat.montantLoyer|number_format(2, ',', ' ') }} €</div>
                            </div>
                            <div class="col-6">
                                <span class="detail-label">Dépôt de garantie</span>
                                <div class="detail-value text-muted">{{ contrat.montantCaution|number_format(2, ',', ' ') }} €</div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="detail-item">
                                <span class="detail-label">Date de début</span>
                                <div class="detail-value text-dark">{{ contrat.dateDebut|date('d/m/Y') }}</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="detail-item">
                                <span class="detail-label">Date de fin</span>
                                <div class="detail-value">
                                    {% if contrat.dateFin %}
                                        {{ contrat.dateFin|date('d/m/Y') }}
                                    {% else %}
                                        <span class="badge bg-soft-success">CONTRAT ACTIF</span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="detail-item border-0">
                        <span class="detail-label">Statut du contrat</span>
                        <div class="d-flex align-items-center gap-2">
                            {% if contrat.statut == 'actif' %}
                                <div class="rounded-circle bg-success" style="width: 10px; height: 10px;"></div>
                                <span class="fw-bold text-success">Actif & Validé</span>
                            {% else %}
                                <div class="rounded-circle bg-warning" style="width: 10px; height: 10px;"></div>
                                <span class="fw-bold text-warning">{{ contrat.statut|capitalize }}</span>
                            {% endif %}
                        </div>
                    </div>
                {% else %}
                    <div class="text-center py-5">
                        <i class="bi bi-file-earmark-break text-muted" style="font-size: 3rem; opacity: 0.3;"></i>
                        <p class="mt-3 text-muted fw-bold">Aucun contrat actif trouvé.</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    {# Consumptions Summary Section #}
    <div class="glass-card p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="section-title mb-0"><i class="bi bi-lightning-charge-fill text-warning"></i> Consommations Récentes</h3>
            <a href="{{ path('consumption') }}" class="btn btn-primary btn-sm rounded-pill px-4 fw-bold shadow-sm">Historique complet</a>
        </div>

        {% if consommations|length > 0 %}
            <div class="row g-3">
                {% for consumption in consommations|slice(0, 3) %}
                    <div class="col-md-4">
                        <div class="conso-mini-card">
                            <div class="detail-label mb-2">
                                {% if 'kwh' in consumption.unite|lower %}Électricité
                                {% elseif 'm3' in consumption.unite|lower %}Consommation d'Eau
                                {% else %}{{ consumption.unite }}{% endif %}
                            </div>
                            <div class="d-flex align-items-baseline gap-1">
                                <span class="fs-3 fw-bold text-dark">{{ consumption.valeur|number_format(1, ',', ' ') }}</span>
                                <span class="small fw-bold text-muted">{{ consumption.unite }}</span>
                            </div>
                            <div class="text-muted small mt-2">
                                Période : {{ consumption.periodeDebut|date('M Y') }}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="text-center p-4 bg-white rounded-4 border border-light">
                <p class="text-muted mb-0">Aucune relevé de consommation récent.</p>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}

