{% extends 'base.html.twig' %}

{% block title %}Incidents - HabitaGo{% endblock %}

{% block body %}
<style>
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .animate-fade-in {
        animation: fadeIn 0.5s ease-out forwards;
    }

    .page-header {
        margin-bottom: 2.5rem;
    }

    .page-title {
        font-weight: 800;
        font-size: 1.5rem;
        color: #1e293b;
        margin-bottom: 0.5rem;
    }

    .stat-mini-card {
        padding: 1.25rem;
        text-align: center;
        transition: transform 0.3s ease;
    }

    .stat-mini-card:hover {
        transform: translateY(-5px);
    }

    .stat-number {
        font-size: 1.5rem;
        font-weight: 800;
        display: block;
        margin-bottom: 0.25rem;
    }

    .stat-label {
        font-weight: 700;
        color: #64748b;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    /* Table Improvements */
    .table-container {
        overflow: hidden;
        border-radius: 16px;
    }

    .modern-table {
        margin-bottom: 0;
    }

    .modern-table thead th {
        background: rgba(0,0,0,0.02);
        border-bottom: 1px solid rgba(0,0,0,0.05);
        padding: 1.25rem 1rem;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.75rem;
        color: #64748b;
    }

    .modern-table tbody td {
        padding: 1.25rem 1rem;
        vertical-align: middle;
        border-bottom: 1px solid rgba(0,0,0,0.03);
    }

    .modern-table tbody tr:last-child td {
        border-bottom: none;
    }

    .badge-status {
        padding: 0.5rem 1rem;
        border-radius: 30px;
        font-weight: 700;
        font-size: 0.7rem;
        text-transform: uppercase;
    }

    .bg-soft-danger { background: #fee2e2; color: #991b1b; }
    .bg-soft-warning { background: #fef9c3; color: #854d0e; }
    .bg-soft-success { background: #dcfce7; color: #166534; }
    .bg-soft-info { background: #e0f2fe; color: #075985; }

</style>

<div class="container-fluid animate-fade-in">
    {# Messages flash #}
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-modern alert-{{ type == 'success' ? 'success' : 'danger' }} border-0 mb-4 shadow-sm animate-fade-in">
                <i class="bi bi-{{ type == 'success' ? 'check-circle' : 'exclamation-circle' }} me-2"></i>
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <header class="page-header d-flex justify-content-between align-items-center">
        <div>
            <h1 class="page-title">Mes Incidents</h1>
            <p class="text-muted fw-bold">Signaler un problème ou suivre vos demandes.</p>
        </div>
        <a href="{{ path('issues_new') }}" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
            <i class="bi bi-plus-lg me-2"></i> Nouvel Incident
        </a>
    </header>

    {# Stats Overview #}
    {% set pending = incidents|filter(i => i.dateResolution is null) %}
    {% set resolved = incidents|filter(i => i.dateResolution is not null) %}

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="glass-card stat-mini-card">
                <span class="stat-number text-danger">{{ pending|length }}</span>
                <span class="stat-label">En cours</span>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-card stat-mini-card">
                <span class="stat-number text-success">{{ resolved|length }}</span>
                <span class="stat-label">Résolus</span>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-card stat-mini-card">
                <span class="stat-number text-primary">{{ incidents|length }}</span>
                <span class="stat-label">Total Signalés</span>
            </div>
        </div>
    </div>

    {# Active Issues List #}
    <div class="glass-card p-0 table-container">
        <div class="p-4 border-bottom border-light">
            <h3 class="section-title mb-0"><i class="bi bi-list-task text-primary"></i> Historique des signalements</h3>
        </div>
        
        <div class="table-responsive">
            <table class="table modern-table">
                <thead>
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Catégorie</th>
                        <th>Titre</th>
                        <th>Priorité</th>
                        <th>Statut</th>
                        <th>Date</th>
                        <th class="text-end pe-4">Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for incident in incidents %}
                        <tr>
                            <td class="ps-4 fw-bold text-muted">#{{ "%03d"|format(incident.id) }}</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    {% if incident.categorie == 'plomberie' %}<i class="bi bi-droplet text-primary"></i>
                                    {% elseif incident.categorie == 'electricite' %}<i class="bi bi-lightning text-warning"></i>
                                    {% elseif incident.categorie == 'chauffage' %}<i class="bi bi-thermometer-half text-danger"></i>
                                    {% else %}<i class="bi bi-tools text-secondary"></i>{% endif %}
                                    <span class="fw-bold text-dark text-capitalize">{{ incident.categorie }}</span>
                                </div>
                            </td>
                            <td class="fw-bold text-dark">{{ incident.titre }}</td>
                            <td>
                                <span class="badge-status bg-soft-{{ incident.priorite == 'urgente' ? 'danger' : (incident.priorite == 'haute' ? 'warning' : 'info') }}">
                                    {{ incident.priorite }}
                                </span>
                            </td>
                            <td>
                                {% if incident.dateResolution is null %}
                                    <span class="badge-status bg-soft-warning d-inline-flex align-items-center">
                                        <span class="spinner-grow spinner-grow-sm me-2" role="status"></span> En cours
                                    </span>
                                {% else %}
                                    <span class="badge-status bg-soft-success">
                                        <i class="bi bi-check2-circle me-1"></i> Résolu
                                    </span>
                                {% endif %}
                            </td>
                            <td class="text-muted small fw-bold">{{ incident.dateCreation|date('d/m/Y') }}</td>
                            <td class="text-end pe-4">
                                <a href="{{ path('issues_show', {id: incident.id}) }}" class="btn btn-light btn-sm rounded-pill px-3 fw-bold border-0" style="background: rgba(0,0,0,0.05);">Détails</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="py-4">
                                    <i class="bi bi-clipboard-check text-success mb-3 d-block" style="font-size: 3rem; opacity: 0.3;"></i>
                                    <p class="text-muted fw-bold">Aucun incident à signaler. Tout semble fonctionner parfaitement !</p>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# Emergency Info Helper #}
    <div class="row g-4 mt-2">
        <div class="col-md-6">
            <div class="glass-card p-4">
                <h4 class="section-title fs-6"><i class="bi bi-telephone-outbound text-danger"></i> Numéros d'urgence</h4>
                <div class="d-flex flex-column gap-2 small fw-bold">
                    <div class="d-flex justify-content-between p-2 bg-white rounded-3 border border-light">
                        <span class="text-muted">Gérant / Admin</span>
                        <span class="text-dark">06 12 34 56 78</span>
                    </div>
                    <div class="d-flex justify-content-between p-2 bg-white rounded-3 border border-light">
                        <span class="text-muted">Gardien Immeuble</span>
                        <span class="text-dark">06 23 45 67 89</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="glass-card p-4">
                <h4 class="section-title fs-6"><i class="bi bi-info-circle text-info"></i> Process d'intervention</h4>
                <p class="small text-muted mb-0">
                    Les signalements <strong>Urgents</strong> sont traités sous 24h. Les demandes standards sous 5 jours ouvrés. Merci de joindre des photos si possible lors de la création.
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
