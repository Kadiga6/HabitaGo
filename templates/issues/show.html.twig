{% extends 'base.html.twig' %}

{% block title %}Détails incident #{{ incident.id }} - HabitaGo{% endblock %}

{% block body %}
<style>
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .animate-fade-in {
        animation: fadeIn 0.5s ease-out forwards;
    }

    .page-header {
        margin-bottom: 2.5rem;
    }

    .page-title {
        font-weight: 800;
        font-size: 1.5rem;
        color: #1e293b;
        margin-bottom: 0.5rem;
    }

    .detail-label {
        font-weight: 700;
        color: #64748b;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 0.5rem;
    }

    .detail-value {
        font-weight: 600;
        color: #1e293b;
        font-size: 1rem;
    }

    .description-card {
        background: rgba(255, 255, 255, 0.5);
        border: 1px solid rgba(0,0,0,0.03);
        border-radius: 16px;
        padding: 1.5rem;
        line-height: 1.7;
        color: #475569;
    }

    .status-timeline {
        position: relative;
        padding-left: 2rem;
    }

    .status-timeline::before {
        content: '';
        position: absolute;
        left: 7px;
        top: 0;
        bottom: 0;
        width: 2px;
        background: rgba(102, 126, 234, 0.2);
    }

    .timeline-item {
        position: relative;
        margin-bottom: 2rem;
    }

    .timeline-item::before {
        content: '';
        position: absolute;
        left: -2rem;
        top: 0.25rem;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: white;
        border: 4px solid #667eea;
        z-index: 1;
    }

    .timeline-item.completed::before {
        background: #22c55e;
        border-color: #22c55e;
    }

    .timeline-item.pending::before {
        background: #f59e0b;
        border-color: #fef3c7;
    }

</style>

<div class="container-fluid animate-fade-in">
    <header class="page-header d-flex align-items-center gap-3">
        <a href="{{ path('issues') }}" class="btn btn-light rounded-circle shadow-sm d-flex align-items-center justify-content-center p-0" style="width: 40px; height: 40px; background: white; border: none;">
            <i class="bi bi-chevron-left text-primary"></i>
        </a>
        <div>
            <h1 class="page-title mb-0">Détails de l'incident</h1>
            <p class="text-muted fw-bold mb-0">Suivi #${{ "%03d"|format(incident.id) }} — {{ incident.titre }}</p>
        </div>
    </header>

    <div class="row g-4 mb-5">
        {# Left Column: Details #}
        <div class="col-lg-8">
            <div class="glass-card p-4">
                <div class="row g-4 mb-5">
                    <div class="col-md-4">
                        <div class="detail-label">Catégorie</div>
                        <div class="detail-value d-flex align-items-center gap-2">
                            {% if incident.categorie == 'plomberie' %}<i class="bi bi-droplet-fill text-primary"></i>
                            {% elseif incident.categorie == 'electricite' %}<i class="bi bi-lightning-fill text-warning"></i>
                            {% elseif incident.categorie == 'chauffage' %}<i class="bi bi-thermometer-half text-danger"></i>
                            {% else %}<i class="bi bi-tools text-secondary"></i>{% endif %}
                            {{ incident.categorie|capitalize }}
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="detail-label">Priorité</div>
                        <div class="detail-value">
                            <span class="badge-status bg-soft-{{ incident.priorite == 'urgente' ? 'danger' : (incident.priorite == 'haute' ? 'warning' : 'info') }}">
                                {{ incident.priorite|capitalize }}
                            </span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="detail-label">Date de signalement</div>
                        <div class="detail-value">{{ incident.dateCreation|date('d/m/Y') }} <span class="text-muted small">à {{ incident.dateCreation|date('H:i') }}</span></div>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="detail-label mb-3">Description du problème</div>
                    <div class="description-card">
                        {{ incident.description|nl2br }}
                    </div>
                </div>

                {# Photos Placeholder or Real? (Assuming none based on entity, but good for UI) #}
                <div class="p-3 rounded-4 border border-dashed border-light text-center py-4">
                    <i class="bi bi-image text-muted mb-2 d-block" style="font-size: 1.5rem;"></i>
                    <p class="text-muted small fw-bold mb-0">Aucune photo jointe à ce signalement.</p>
                </div>
            </div>
        </div>

        {# Right Column: Status Timeline #}
        <div class="col-lg-4">
            <div class="glass-card p-4">
                <h3 class="section-title fs-6 mb-4"><i class="bi bi-activity text-primary"></i> État du traitement</h3>
                
                <div class="status-timeline">
                    {# Item: Declaration #}
                    <div class="timeline-item completed">
                        <div class="fw-bold text-dark small">Signalement reçu</div>
                        <div class="text-muted x-small fw-bold">{{ incident.dateCreation|date('d/m/Y H:i') }}</div>
                    </div>

                    {# Item: Analysis #}
                    <div class="timeline-item {{ incident.dateResolution ? 'completed' : 'pending' }}">
                        <div class="fw-bold text-dark small">Analyse technique</div>
                        {% if incident.dateResolution %}
                            <div class="text-muted x-small fw-bold">Effectuée par l'équipe maintenance</div>
                        {% else %}
                            <div class="text-muted x-small fw-bold">En cours d'examen...</div>
                        {% endif %}
                    </div>

                    {# Item: Resolution #}
                    {% if incident.dateResolution %}
                    <div class="timeline-item completed">
                        <div class="fw-bold text-dark small">Résolu</div>
                        <div class="text-muted x-small fw-bold">{{ incident.dateResolution|date('d/m/Y H:i') }}</div>
                    </div>
                    {% else %}
                    <div class="timeline-item text-muted opacity-50">
                        <div class="fw-bold small">Intervention & Clôture</div>
                        <div class="x-small">En attente des étapes précédentes</div>
                    </div>
                    {% endif %}
                </div>

                {% if not incident.dateResolution %}
                <div class="mt-4 p-3 rounded-3 bg-soft-info border-0 small fw-bold text-info">
                    <i class="bi bi-info-circle me-2"></i> Un technicien vous contactera prochainement pour planifier l'intervention.
                </div>
                {% else %}
                <div class="mt-4 p-3 rounded-3 bg-soft-success border-0 small fw-bold text-success">
                    <i class="bi bi-check2-circle me-2"></i> Intervention terminée. Si le problème persiste, contactez le gardien.
                </div>
                {% endif %}
            </div>

            <div class="mt-4 px-2">
                <a href="{{ path('issues') }}" class="btn btn-primary w-100 rounded-pill fw-bold shadow-sm py-2">
                    Retour à la liste
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
