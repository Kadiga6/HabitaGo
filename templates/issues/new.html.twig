{% extends 'base.html.twig' %}

{% block title %}Déclarer un incident - HabitaGo{% endblock %}

{% block body %}
<style>
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .animate-fade-in {
        animation: fadeIn 0.5s ease-out forwards;
    }

    .page-header {
        margin-bottom: 2.5rem;
    }

    .page-title {
        font-weight: 800;
        font-size: 1.5rem;
        color: #1e293b;
        margin-bottom: 0.5rem;
    }

    /* Form Styling */
    .form-glass-group {
        margin-bottom: 1.5rem;
    }

    .form-glass-label {
        font-weight: 700;
        color: #64748b;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.5rem;
        display: block;
    }

    .form-glass-control {
        background: rgba(255, 255, 255, 0.8) !important;
        border: 1px solid rgba(0,0,0,0.05) !important;
        border-radius: 12px !important;
        padding: 0.75rem 1rem !important;
        font-weight: 500 !important;
        color: #1e293b !important;
        transition: all 0.2s ease !important;
    }

    .form-glass-control:focus {
        background: white !important;
        border-color: #667eea !important;
        box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1) !important;
        transform: translateY(-1px);
    }

    /* Tips Card */
    .tips-card {
        background: linear-gradient(135deg, rgba(102, 126, 234, 0.05) 0%, rgba(118, 75, 162, 0.05) 100%);
        border: 1px solid rgba(102, 126, 234, 0.1);
        border-radius: 16px;
        padding: 1.5rem;
    }

</style>

<div class="container-fluid animate-fade-in">
    <header class="page-header d-flex align-items-center gap-3">
        <a href="{{ path('issues') }}" class="btn btn-light rounded-circle shadow-sm d-flex align-items-center justify-content-center p-0" style="width: 40px; height: 40px; background: white; border: none;">
            <i class="bi bi-chevron-left text-primary"></i>
        </a>
        <div>
            <h1 class="page-title mb-0">Signaler un Incident</h1>
            <p class="text-muted fw-bold mb-0">Demander une intervention technique dans votre logement.</p>
        </div>
    </header>

    <div class="row g-4 mb-5">
        {# Main Form Column #}
        <div class="col-lg-8">
            <div class="glass-card p-4">
                {# Header Info #}
                {% if contrat %}
                <div class="p-3 rounded-4 bg-white border border-light mb-4 d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-soft-info p-2">
                        <i class="bi bi-geo-alt-fill"></i>
                    </div>
                    <div>
                        <div class="small text-muted fw-bold">LIEU D'INTERVENTION</div>
                        <div class="fw-bold text-dark">
                            {{ (contrat and contrat.logement) ? (contrat.logement.adresse ~ ', ' ~ contrat.logement.ville) : 'Non assigné' }}
                        </div>
                    </div>
                </div>
                {% endif %}

                {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
                    <div class="form-glass-group">
                        <label class="form-glass-label">Objet du signalement</label>
                        {{ form_widget(form.titre, {'attr': {'class': 'form-control form-glass-control', 'placeholder': 'Ex: Fuite sous l\'évier de la cuisine'}}) }}
                        {{ form_errors(form.titre) }}
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-glass-group">
                                <label class="form-glass-label">Catégorie</label>
                                {{ form_widget(form.categorie, {'attr': {'class': 'form-select form-glass-control'}}) }}
                                {{ form_errors(form.categorie) }}
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-glass-group">
                                <label class="form-glass-label">Niveau d'urgence</label>
                                {{ form_widget(form.priorite, {'attr': {'class': 'form-select form-glass-control'}}) }}
                                {{ form_errors(form.priorite) }}
                            </div>
                        </div>
                    </div>

                    <div class="form-glass-group">
                        <label class="form-glass-label">Description détaillée</label>
                        {{ form_widget(form.description, {'attr': {'class': 'form-control form-glass-control', 'rows': '5', 'placeholder': 'Décrivez précisément le problème...'}}) }}
                        {{ form_errors(form.description) }}
                    </div>

                    <div class="d-flex justify-content-end gap-3 mt-4">
                        <a href="{{ path('issues') }}" class="btn btn-light rounded-pill px-4 fw-bold border-0" style="background: rgba(0,0,0,0.05);">Annuler</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">
                            <i class="bi bi-send-fill me-2"></i> Envoyer le signalement
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>

        {# Tips Column #}
        <div class="col-lg-4">
            <div class="tips-card mb-4 animate-fade-in" style="animation-delay: 0.1s">
                <h3 class="section-title fs-6"><i class="bi bi-lightbulb-fill text-warning"></i> Conseils</h3>
                <ul class="list-unstyled d-flex flex-column gap-3 small text-muted fw-bold">
                    <li class="d-flex gap-3">
                        <i class="bi bi-1-circle-fill text-primary"></i>
                        <span>Soyez <strong>précis</strong> dans le titre pour une identification rapide.</span>
                    </li>
                    <li class="d-flex gap-3">
                        <i class="bi bi-2-circle-fill text-primary"></i>
                        <span>Décrivez l'impact (ex: coupure totale, débit réduit).</span>
                    </li>
                    <li class="d-flex gap-3">
                        <i class="bi bi-3-circle-fill text-primary"></i>
                        <span>N'utilisez "Urgent" que pour les problèmes bloquants.</span>
                    </li>
                </ul>
            </div>

            <div class="glass-card p-4 animate-fade-in" style="animation-delay: 0.2s">
                <h3 class="section-title fs-6"><i class="bi bi-clock-history text-secondary"></i> Prochaine étape</h3>
                <p class="small text-muted fw-bold mb-0">
                    Une fois envoyé, votre incident sera examiné par l'équipe technique. Vous recevrez une notification dès qu'un technicien sera planifié.
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
