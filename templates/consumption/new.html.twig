{% extends 'base.html.twig' %}

{% block title %}Ajouter une consommation - HabitaGo{% endblock %}

{% block body %}
<style>
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .animate-fade-in {
        animation: fadeIn 0.5s ease-out forwards;
    }

    .page-header {
        margin-bottom: 2.5rem;
    }

    .page-title {
        font-weight: 800;
        font-size: 1.5rem;
        color: #1e293b;
        margin-bottom: 0.5rem;
    }

    .form-section-title {
        font-weight: 800;
        font-size: 1.1rem;
        color: #1e293b;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .logement-badge {
        background: rgba(102, 126, 234, 0.05);
        border: 1px solid rgba(102, 126, 234, 0.1);
        padding: 1rem;
        border-radius: 12px;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .logement-icon {
        width: 40px;
        height: 40px;
        background: white;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        color: #667eea;
    }

</style>

<div class="container-fluid animate-fade-in">
    <header class="page-header d-flex align-items-center gap-3">
        <a href="{{ path('consumption') }}" class="btn btn-light rounded-circle shadow-sm d-flex align-items-center justify-content-center p-0" style="width: 40px; height: 40px; background: white; border: none;">
            <i class="bi bi-chevron-left text-primary"></i>
        </a>
        <div>
            <h1 class="page-title mb-0">Nouveau relevé</h1>
            <p class="text-muted fw-bold mb-0">Enregistrez vos indices pour un suivi précis.</p>
        </div>
    </header>

    <div class="row">
        <div class="col-lg-8">
            <div class="glass-card p-4">
                {{ form_start(form, { 'attr': { 'class': 'needs-validation' } }) }}
                
                <h2 class="form-section-title">
                    <i class="bi bi-pencil-square text-primary"></i> Informations du relevé
                </h2>

                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="mb-4">
                            {{ form_label(form.type, 'Type de ressource', { 'label_attr': { 'class': 'form-label fw-bold small text-uppercase text-muted' } }) }}
                            {{ form_widget(form.type, { 'attr': { 'class': 'form-select form-glass-control' } }) }}
                            {{ form_errors(form.type) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-4">
                            {{ form_label(form.valeur, 'Index relevé', { 'label_attr': { 'class': 'form-label fw-bold small text-uppercase text-muted' } }) }}
                            <div class="input-group">
                                {{ form_widget(form.valeur, { 'attr': { 'class': 'form-control form-glass-control', 'placeholder': 'Ex: 1240.5' } }) }}
                                <span class="input-group-text bg-white border-start-0" id="unite-display" style="border-radius: 0 12px 12px 0; border-color: rgba(255,255,255,0.5); font-weight: 700; color: #64748b; min-width: 60px; text-align: center;">-</span>
                            </div>
                            {{ form_errors(form.valeur) }}
                        </div>
                    </div>
                </div>

                <h2 class="form-section-title mt-4">
                    <i class="bi bi-calendar-event text-primary"></i> Période de consommation
                </h2>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        {{ form_label(form.periodeDebut, 'Du (Début)', { 'label_attr': { 'class': 'form-label fw-bold small text-uppercase text-muted' } }) }}
                        {{ form_widget(form.periodeDebut, { 'attr': { 'class': 'form-control form-glass-control' } }) }}
                        {{ form_errors(form.periodeDebut) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.periodeFin, 'Au (Fin)', { 'label_attr': { 'class': 'form-label fw-bold small text-uppercase text-muted' } }) }}
                        {{ form_widget(form.periodeFin, { 'attr': { 'class': 'form-control form-glass-control' } }) }}
                        {{ form_errors(form.periodeFin) }}
                    </div>
                </div>

                <div class="mt-5 d-flex gap-3">
                    <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">
                        Enregistrer le relevé
                    </button>
                    <a href="{{ path('consumption') }}" class="btn btn-light rounded-pill px-4 fw-bold">
                        Annuler
                    </a>
                </div>

                {{ form_end(form) }}
            </div>
        </div>

        <div class="col-lg-4">
            <div class="glass-card p-4">
                <h3 class="section-title fs-6 mb-4"><i class="bi bi-house text-primary"></i> Logement concerné</h3>
                <div class="logement-badge">
                    <div class="logement-icon">
                        <i class="bi bi-geo-alt-fill"></i>
                    </div>
                    <div>
                        {% if logement %}
                            <div class="fw-bold text-dark">{{ logement.adresse }}</div>
                            <div class="text-muted small fw-bold">{{ logement.codePostal }} {{ logement.ville }}</div>
                        {% else %}
                            <div class="fw-bold text-dark">Non assigné</div>
                        {% endif %}
                    </div>
                </div>

                <div class="mt-4 p-3 rounded-4 bg-soft-info border-0">
                    <div class="d-flex gap-2">
                        <i class="bi bi-info-circle-fill text-info mt-1"></i>
                        <p class="small text-info fw-bold mb-0">
                            Assurez-vous de saisir l'index exact figurant sur votre compteur physique.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const typeSelectId = '{{ form.type.vars.id }}';
        const typeSelect = document.getElementById(typeSelectId);
        const uniteDisplay = document.getElementById('unite-display');

        function updateUnite() {
            const val = typeSelect.value;
            if (val === 'eau') uniteDisplay.textContent = 'm³';
            else if (val === 'electricite' || val === 'gaz') uniteDisplay.textContent = 'kWh';
            else uniteDisplay.textContent = '-';
        }

        if (typeSelect) {
            updateUnite();
            typeSelect.addEventListener('change', updateUnite);
        }
    });
</script>
{% endblock %}

{% endblock %}
