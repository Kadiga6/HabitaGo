{% extends 'base.html.twig' %}

{% block title %}Consommations - HabitaGo{% endblock %}

{% block body %}
<style>
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .animate-fade-in {
        animation: fadeIn 0.5s ease-out forwards;
    }

    .page-header {
        margin-bottom: 2.5rem;
    }

    .page-title {
        font-weight: 800;
        font-size: 1.5rem;
        color: #1e293b;
        margin-bottom: 0.5rem;
    }

    .conso-card {
        padding: 1.25rem;
        transition: transform 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .conso-card:hover {
        transform: translateY(-5px);
    }

    .conso-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 1rem;
    }

    .bg-soft-amber { background: #fffbeb; color: #d97706; }
    .bg-soft-blue { background: #eff6ff; color: #2563eb; }
    .bg-soft-orange { background: #fff7ed; color: #ea580c; }

    .conso-value {
        font-size: 1.5rem;
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 0.25rem;
    }

    .conso-label {
        font-weight: 700;
        color: #64748b;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    /* Table Improvements */
    .table-container {
        overflow: hidden;
        border-radius: 16px;
    }

    .modern-table {
        margin-bottom: 0;
    }

    .modern-table thead th {
        background: rgba(0,0,0,0.02);
        border-bottom: 1px solid rgba(0,0,0,0.05);
        padding: 1.25rem 1rem;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.75rem;
        color: #64748b;
    }

    .modern-table tbody td {
        padding: 1.25rem 1rem;
        vertical-align: middle;
        border-bottom: 1px solid rgba(0,0,0,0.03);
    }

    .badge-conso {
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
        font-weight: 700;
        font-size: 0.75rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

</style>

<div class="container-fluid animate-fade-in">
    <header class="page-header d-flex justify-content-between align-items-center">
        <div>
            <h1 class="page-title">Mes Consommations</h1>
            <p class="text-muted fw-bold">Suivi et analyse de vos dépenses énergétiques.</p>
        </div>
        <a href="{{ path('consumption_new') }}" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
            <i class="bi bi-plus-lg me-2"></i> Ajouter un relevé
        </a>
    </header>

    {# Stats Grid #}
    {% set elecTotal = 0 %}
    {% set eauTotal = 0 %}
    {% set gazTotal = 0 %}
    {% for conso in consommations %}
        {% if conso.type|lower == 'electricite' or 'elec' in conso.type|lower %}{% set elecTotal = elecTotal + conso.valeur %}
        {% elseif 'eau' in conso.type|lower or 'm³' in conso.unite or 'm3' in conso.unite %}{% set eauTotal = eauTotal + conso.valeur %}
        {% elseif conso.type|lower == 'gaz' %}{% set gazTotal = gazTotal + conso.valeur %}{% endif %}
    {% endfor %}

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="glass-card conso-card">
                <div class="conso-icon bg-soft-amber">
                    <i class="bi bi-lightning-charge-fill"></i>
                </div>
                <div class="conso-value">{{ elecTotal|number_format(1, ',', ' ') }} <small class="fs-6 text-muted">kWh</small></div>
                <div class="conso-label">Électricité (Total)</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-card conso-card">
                <div class="conso-icon bg-soft-blue">
                    <i class="bi bi-droplet-fill"></i>
                </div>
                <div class="conso-value">{{ eauTotal|number_format(1, ',', ' ') }} <small class="fs-6 text-muted">m³</small></div>
                <div class="conso-label">Eau (Total)</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-card conso-card">
                <div class="conso-icon bg-soft-orange">
                    <i class="bi bi-fire"></i>
                </div>
                <div class="conso-value">{{ gazTotal|number_format(1, ',', ' ') }} <small class="fs-6 text-muted">kWh</small></div>
                <div class="conso-label">Gaz (Total)</div>
            </div>
        </div>
    </div>

    {# History Table #}
    <div class="glass-card p-0 table-container mb-5">
        <div class="p-4 border-bottom border-light">
            <h3 class="section-title mb-0"><i class="bi bi-clock-history text-primary"></i> Historique des relevés</h3>
        </div>
        
        <div class="table-responsive">
            <table class="table modern-table">
                <thead>
                    <tr>
                        <th class="ps-4">Période</th>
                        <th>Électricité</th>
                        <th>Eau</th>
                        <th>Gaz</th>
                    </tr>
                </thead>
                <tbody>
                    {# Grouping by period - using the same logic as before but with better styling #}
                    {% set periodes = {} %}
                    {% for conso in consommations %}
                        {% set pKey = conso.periodeDebut|date('Y-m-d') ~ '_' ~ conso.periodeFin|date('Y-m-d') %}
                        {% if periodes[pKey] is not defined %}
                            {% set periodes = periodes|merge({(pKey): {'debut': conso.periodeDebut, 'fin': conso.periodeFin, 'items': []}}) %}
                        {% endif %}
                        {% set periodes = periodes|merge({(pKey): {'debut': periodes[pKey].debut, 'fin': periodes[pKey].fin, 'items': periodes[pKey].items|merge([conso])}}) %}
                    {% endfor %}

                    {% for pKey, p in periodes %}
                        <tr>
                            <td class="ps-4 fw-bold text-dark">
                                <i class="bi bi-calendar3 text-muted me-2"></i>
                                {{ p.debut|date('d/m/Y') }} <i class="bi bi-arrow-right mx-1 opacity-50"></i> {{ p.fin|date('d/m/Y') }}
                            </td>
                            <td>
                                {% set eVal = 0 %}{% for i in p.items %}{% if 'elec' in i.type|lower %}{% set eVal = eVal + i.valeur %}{% endif %}{% endfor %}
                                {% if eVal > 0 %}<span class="badge-conso bg-soft-amber"><i class="bi bi-lightning-charge-fill"></i> {{ eVal|number_format(1, ',', ' ') }} kWh</span>
                                {% else %}<span class="text-muted small">--</span>{% endif %}
                            </td>
                            <td>
                                {% set wVal = 0 %}{% for i in p.items %}{% if i.unite == 'm³' or i.unite == 'm3' %}{% set wVal = wVal + i.valeur %}{% endif %}{% endfor %}
                                {% if wVal > 0 %}<span class="badge-conso bg-soft-blue"><i class="bi bi-droplet-fill"></i> {{ wVal|number_format(1, ',', ' ') }} m³</span>
                                {% else %}<span class="text-muted small">--</span>{% endif %}
                            </td>
                            <td>
                                {% set gVal = 0 %}{% for i in p.items %}{% if i.type|lower == 'gaz' %}{% set gVal = gVal + i.valeur %}{% endif %}{% endfor %}
                                {% if gVal > 0 %}<span class="badge-conso bg-soft-orange"><i class="bi bi-fire"></i> {{ gVal|number_format(1, ',', ' ') }} kWh</span>
                                {% else %}<span class="text-muted small">--</span>{% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center py-5">
                                <div class="py-4">
                                    <i class="bi bi-bar-chart-line text-muted mb-3 d-block" style="font-size: 3rem; opacity: 0.3;"></i>
                                    <p class="text-muted fw-bold">Aucun relevé enregistré. Commencez par ajouter vos premières consommations.</p>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# Tips Section #}
    <div class="row g-4">
        <div class="col-md-12">
            <div class="glass-card p-4" style="background: linear-gradient(135deg, rgba(34, 197, 94, 0.05) 0%, rgba(102, 126, 234, 0.05) 100%);">
                <h4 class="section-title fs-6"><i class="bi bi-lightbulb-fill text-success"></i> Éco-gestes du mois</h4>
                <div class="row g-3 mt-2">
                    <div class="col-md-4">
                        <div class="p-3 bg-white rounded-4 border border-light small fw-bold">
                            <i class="bi bi-check2-circle text-success me-2"></i> Éteindre les lumières inutiles
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-white rounded-4 border border-light small fw-bold">
                            <i class="bi bi-check2-circle text-success me-2"></i> Douche rapide vs Bain
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-white rounded-4 border border-light small fw-bold">
                            <i class="bi bi-check2-circle text-success me-2"></i> Température idéale : 19°C
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
